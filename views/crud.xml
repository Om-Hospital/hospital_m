<odoo>
    <template id="create">
        <html>
            <head>
                <title>Crud Operation</title>
            </head>
            <body>
                <h1>Create Product</h1>
                <br/>
                <form action="/crud/create/process" method="post" enctype="multipart/form-data">
                    <div>Name</div>
                    <input type="text" name="name"/>
                    <br/>
                    <br/>
                    <div>Price</div>
                    <input type="text" name="list_price"/>
                    <br/>
                    <br/>
                    <div>Image</div>
                    <input type="file" name="image_1920"/>
                    <br/>
                    <br/>
                    <button type="submit">Create Product</button>
                </form>
            </body>
        </html>
    </template>

    <template id="create_process">
        <html>
            <head>
                <title>Crud Operation</title>
            </head>
            <body>
                <h1>Product Created Successfully</h1>
                <br/>
                <a t-att-href="'/crud/read_all'">Read all product</a>
            </body>
        </html>
    </template>

    <template id="read_all">
        <html>
            <head>
                <title>Crud Operation</title>
            </head>
            <body>
                <h1>Product read all</h1>
                <br/>
                <br/>

                <div t-foreach="products" t-as="product">
                    <a t-att-href="'/crud/read?product_id=%d' % product.id ">
                        <div class="d-flex">
                            <div class="d-flex">
                                <div>Name :</div>
                                <p t-esc="product.name">_</p>
                            </div>
                            <br/>
                            <br/>
                        </div>
                    </a>
                </div>

            </body>
        </html>
    </template>

    <template id="read">
        <html>
            <head>
                <title>Crud Operation</title>
            </head>
            <body>
                <h1>Product read</h1>
                <br/>
                <br/>

                <div t-foreach="product" t-as="product">
                    <div>Name:</div>
                    <div t-esc="product.name">_</div>
                    <br/>
                    <div>Price:</div>
                    <div t-esc="product.list_price">_</div>
                    <hr/>
                </div>
                <a t-att-href="'/crud/update?product_id=%d' % product.id">Edit Product</a>
                <br/>
                <br/>
                <a t-att-href="'/crud/delete?product_id=%d' % product.id">Delete Product</a>
                <br/>
                <br/>
                <a t-att-href="'/home'">Home Page</a>

            </body>
        </html>
    </template>


    <template id="update">
        <html>

            <head>
                <title>Crud Operation</title>
            </head>

            <body>
                <form t-att-action="'/crud/update/process?product_id=%d' % product.id" method="post"
                      enctype="multipart/form-data">
                    <h1>Product update</h1>
                    <br/>
                    <br/>

                    <div>Name:</div>
                    <input type="text" name="name" t-att-value="product.name"/>
                    <input type="text" name="list_price" t-att-value="product.list_price"/>
                    <input type="file" name="name" t-att-value="product.image_1920"/>

                    <button type="submit">Update product</button>
                </form>
            </body>
        </html>
    </template>

    <template id="update_process">
        <html>

            <head>
                <title>Crud Operation</title>
            </head>

            <body>
                <h1>Product Updated Successfully</h1>
                <a t-att-href="'/crud/read_all'">products</a>
            </body>
        </html>
    </template>
    <template id="main_page">
        <html>

            <head>
                <title>Crud Operation</title>
            </head>

            <body>
                <h1>Product Deleted Successfully</h1>
                <a t-att-href="'/crud/read_all'">Read all products</a>
                <br/>
                <br/>
                <a t-att-href="'/crud/create'">Create product</a>
                <br/>
                <br/>
                <a t-att-href="'/home'">Our Home Page</a>
            </body>
        </html>
    </template>

    <template id="home">
        <html>
            <head>
                <title>Home</title>
            </head>
            <body>
                <p>Hello Everyone This is our Home Page</p>
                <br/>
                <br/>
                <a t-att-href="'/crud/read_all'">Read all product</a>
                <br/>
                <br/>
                <a t-att-href="'/crud/read'">Read product</a>
                <br/>
                <br/>

                <t t-if="product.name == 'Honeycomb'" t-esc="product.name">_</t>
                <t t-set="address" t-value="'Rampura, Dhaka'">_</t>
                <p t-esc="address">_</p>

                <img t-att-src="image_data_uri(product.image_1920)" alt="logo"/>
            </body>
        </html>
    </template>
</odoo>